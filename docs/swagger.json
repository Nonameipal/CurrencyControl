                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Счет отправителя",
                        "name": "sender_account",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Наименование получателя",
                        "name": "receiver_name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Счет получателя",
                        "name": "receiver_account",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Страна получателя",
                        "name": "receiver_country",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Предмет",
                        "name": "subject",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
