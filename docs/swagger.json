{
    "swagger": "2.0",
    "info": {
        "description": "API сервера для системы валютного контроля.",
        "title": "Currency Control API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8088",
    "basePath": "/",
    "paths": {
        "/api/v1/companies": {
            "post": {
                "description": "Создает новую компанию (контрагента) с обязательной привязкой к филиалу",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Companies"
                ],
                "summary": "Создание новой компании (ҶДММ)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Логин пользователя",
                        "name": "Login",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Данные для создания компании",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateCompanyRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.CompanyResponse"
                        }
                    },
                    "400": {
                        "description": "Обязательные поля не заполнены",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/contracts": {
            "post": {
                "description": "Создает новый контракт с загрузкой PDF-файла",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Contracts"
                ],
                "summary": "Создание контракта",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Логин пользователя",
                        "name": "Login",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "ID компании (ҶДММ)",
                        "name": "client_id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "ID филиала",
                        "name": "branch_id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Номер контракта",
                        "name": "contract_number",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Название контракта",
                        "name": "contract_name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Дата контракта (YYYY-MM-DD)",
                        "name": "contract_date",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Дата поставки (YYYY-MM-DD)",
                        "name": "delivery_date",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Срок поставки (дни)",
                        "name": "delivery_term_days",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Срок возврата (дни)",
                        "name": "return_term_days",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Сумма контракта",
                        "name": "total_amount",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Валюта контракта",
                        "name": "contract_currency",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Наименование получателя",
                        "name": "receiver_name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Счет получателя",
                        "name": "receiver_account",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Страна получателя",
                        "name": "receiver_country",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Предмет",
                        "name": "subject",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Условия поставки",
                        "name": "delivery_conditions",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "PDF документ",
                        "name": "document",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.Contract"
                        }
                    },
                    "400": {
                        "description": "Неверные данные формы",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/dashboard": {
            "get": {
                "description": "Возвращает список компаний с возможностью фильтрации по названию, сумме, ИНН и филиалу",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Dashboard"
                ],
                "summary": "Поиск для дашборда",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Логин пользователя",
                        "name": "Login",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Название компании",
                        "name": "company_name",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Сумма контракта",
                        "name": "amount",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "ИНН компании",
                        "name": "inn",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "ID филиала",
                        "name": "branch_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.DashboardSearchResult"
                            }
                        }
                    },
                    "400": {
                        "description": "Неверные параметры",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Contract": {
            "type": "object",
            "properties": {
                "additionalAgreement": {
                    "type": "string"
                },
                "branchID": {
                    "type": "integer"
                },
                "clientID": {
                    "type": "integer"
                },
                "contractCurrency": {
                    "type": "string"
                },
                "contractDate": {
                    "type": "string"
                },
                "contractEndDate": {
                    "type": "string"
                },
                "contractName": {
                    "type": "string"
                },
                "contractNumber": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "deliveryConditions": {
                    "type": "string"
                },
                "deliveryDate": {
                    "type": "string"
                },
                "deliveryTermDays": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "receiverAccount": {
                    "type": "string"
                },
                "receiverCountry": {
                    "type": "string"
                },
                "receiverName": {
                    "type": "string"
                },
                "remainingAmount": {
                    "type": "number"
                },
                "returnTermDays": {
                    "type": "integer"
                },
                "subject": {
                    "type": "string"
                },
                "totalAmount": {
                    "type": "number"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "dto.CompanyResponse": {
            "type": "object",
            "properties": {
                "branch_id": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "inn": {
                    "type": "string"
                },
                "llc": {
                    "type": "string"
                }
            }
        },
        "dto.CreateCompanyRequest": {
            "type": "object",
            "properties": {
                "branch_id": {
                    "type": "integer"
                },
                "inn": {
                    "type": "string"
                },
                "llc": {
                    "type": "string"
                }
            }
        },
        "dto.DashboardSearchResult": {
            "type": "object",
            "properties": {
                "company_id": {
                    "type": "integer"
                },
                "company_name": {
                    "type": "string"
                },
                "number": {
                    "type": "string"
                }
            }
        },
        "dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        }
    }
}